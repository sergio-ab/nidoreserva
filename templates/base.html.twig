<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestión de reservas | NidoReserva{% endblock %}</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="site-title" href="/">NidoReserva</a>
            <p class="site-subtitle">Gestión de reservas</p>
        </div>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>Panel de gestión de reservas de NidoReserva</p>
        </div>
    </footer>

    <script src="/js/reservations.js" defer></script>
</body>
</html>
