{% extends "base.html.twig" %}

{% block title %}Crear reserva | NidoReserva{% endblock %}

{% block content %}
    <section class="page-heading">
        <div>
            <h1>Crear reserva</h1>
            <p>Introduce los datos para registrar una nueva reserva.</p>
        </div>

    </section>

    <section class="reservation-list" aria-labelledby="reservation-form-title">
        <h2 id="reservation-form-title">Datos de la reserva</h2>

        <p id="form-message" role="status" aria-live="polite"></p>

        <form id="reservation-create-form">
            <div class="form-group">
                <label for="guest-name">Nombre del huésped</label>
                <input
                    type="text"
                    id="guest-name"
                    name="nombre_huesped"
                    required
                    maxlength="255"
                >
            </div>

            <div class="form-group">
                <label for="guest-email">Correo electrónico</label>
                <input
                    type="email"
                    id="guest-email"
                    name="email_huesped"
                    required
                    maxlength="255"
                >
            </div>

            <div class="form-group">
                <label for="accommodation-name">Nombre del alojamiento</label>
                <input
                    type="text"
                    id="accommodation-name"
                    name="nombre_alojamiento"
                    required
                    maxlength="255"
                >
            </div>

            <div class="form-group">
                <label for="check-in">Fecha de entrada</label>
                <input
                    type="date"
                    id="check-in"
                    name="fecha_entrada"
                    required
                >
            </div>

            <div class="form-group">
                <label for="check-out">Fecha de salida</label>
                <input
                    type="date"
                    id="check-out"
                    name="fecha_salida"
                    required
                >
            </div>

            <div class="form-group">
                <label for="amount">Importe (€)</label>
                <input
                    type="number"
                    id="amount"
                    name="importe"
                    min="0"
                    step="0.01"
                    required
                >
            </div>

            <div class="form-group">
                <label for="notes">Notas (opcional)</label>
                <textarea
                    id="notes"
                    name="notas"
                    rows="4"
                ></textarea>
            </div>

            <div class="form-actions">
                <button class="button" type="submit">Crear reserva</button>
                <a class="button button-secondary" href="/">Volver al listado</a>
            </div>
        </form>
    </section>
{% endblock %}
